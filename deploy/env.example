# Synaptix Studio Console — production environment template.
# Copy to the repo root as `.env` (gitignored) and fill in:
#   cp deploy/env.example .env
#
# Generate a random secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=

# Comma-separated. MUST include the address(es) the browser actually uses —
# the VM's PUBLIC IP (Oracle assigns a private 10.x IP; the browser hits the
# public one, and Django rejects any Host it doesn't recognise), or the tunnel
# hostname if you go the Cloudflare route. Dev default `*` is insecure for
# production — tighten it.
DJANGO_ALLOWED_HOSTS=*

# Comma-separated https origins, only needed behind a TLS proxy on a custom
# domain (e.g. Cloudflare Tunnel): https://console.synaptixstudio.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Container file ownership (leave at 1000 unless your host differs).
HOST_UID=1000
HOST_GID=1000
